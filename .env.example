# Variables del servicio de IA. Copiar a .env (no va a git) y completar.
LOG_FORMAT=text                                  # text | json (la imagen Docker usa json)
APP_ENV=local                                   # local | production (en production el token es obligatorio)
INTERNAL_API_TOKEN=                              # secreto compartido con la API: openssl rand -base64 48
MODEL_PATH=models/modelo_tizon_4c.keras          # en Docker: /models/modelo_tizon_4c.keras
MODEL_META_PATH=models/model_meta.json           # en Docker: /models/model_meta.json
